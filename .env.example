# ════════════════════════════════════════════════════════════════
#  F39 ACTIVITY — .env Dosyası (Bunu .env olarak kaydet!)
# ════════════════════════════════════════════════════════════════
#
# ADIM 1: https://discord.com/developers/applications → Botunu seç → General Information
#         Application ID kopyala → Aşağıya yapıştır (İKİ YERE DE)
DISCORD_CLIENT_ID=buraya_application_id_yapistir
VITE_DISCORD_CLIENT_ID=buraya_application_id_yapistir

# ADIM 2: Bot sayfasında → OAuth2 → Client Secret → Reset Secret → Kopyala
DISCORD_CLIENT_SECRET=buraya_client_secret_yapistir

# ADIM 3: Activity'nin çalıştığı URL
#   - Yerelde test için: http://localhost:3000
#   - Canlıda (Render, Railway, VPS): https://senin-sitenin-adresi.com
PUBLIC_BASE_URL=http://localhost:3000

# ADIM 4: Sunucunun portu (değiştirmene gerek yok)
PORT=3000
